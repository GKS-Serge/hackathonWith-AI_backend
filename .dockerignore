# ==============================================================================
# SCHOLARSHIP / ACADÉMIE - Docker Ignore
# Exclusions strictes pour garantir sécurité, propreté et étanchéité de l'image
# ==============================================================================

# Fichiers d'environnement et secrets (JAMAIS dans l'image)
.env
.env.*
!.env.docker.example

# Référentiel Word source privé (strictement préservé hors image)
storage/app/private/referentiels/

# Données temporaires, caches locaux et logs hôte
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
!storage/logs/.gitkeep
!storage/framework/cache/.gitkeep
!storage/framework/sessions/.gitkeep
!storage/framework/views/.gitkeep

# Git et outils de versioning
.git/
.gitignore
.gitattributes

# Dépendances Composer et Node locales hôte (installées/gérées dans le conteneur)
vendor/
node_modules/

# Outils IDE et scripts de scratch
.idea/
.vscode/
scratch/
.phpunit.result.cache

# Bases de données SQLite locales éventuelles
*.sqlite
