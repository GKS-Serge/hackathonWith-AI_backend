# Exemple de variables d'environnement pour lancer le backend SCHOLARSHIP sous Docker
# Copiez vers .env et renseignez vos secrets localement (NE JAMAIS commiter .env)

APP_NAME=SCHOLARSHIP
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Port hôte exposé (5433 par défaut pour éviter tout conflit avec un PostgreSQL local sur 5432)
PGSQL_EXTERNAL_PORT=5433
BACKEND_PORT=8000

# Base PostgreSQL conteneurisée (en interne Docker utilise DB_HOST=postgres et port 5432)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hackathon_db
DB_USERNAME=scholarship_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Comportement au démarrage du conteneur backend
RUN_MIGRATIONS=true
RUN_SEEDERS=true

# Fournisseur IA (à renseigner uniquement dans votre .env local)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT=30
